# SPARSH - safe defaults
Options -Indexes
<FilesMatch "\.(log|md|json)$">
  Require all denied
</FilesMatch>
<Files "sitemap.xml"> Require all granted </Files>
<Files "robots.txt"> Require all granted </Files>
AddType application/javascript .js
AddType font/woff2 .woff2

# Always re-check files with the server, so updates reach visitors immediately
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|css)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
